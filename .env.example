# Tallessa (Expo / React Native) — Supabase configuration
#
# Copy this file to `.env` and fill in your Supabase project values.
# Only the EXPO_PUBLIC_* names are exposed to the running app — never put
# the Supabase service_role key here or anywhere in the repo. The
# service_role key bypasses RLS and would let any user read/write any data.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-public-anon-key...
EXPO_PUBLIC_SUPABASE_BUCKET=memories
